{
  "fmt": {
    "R": {
      "description": "Register-to-register operations. All operands are registers, result stored in rd.",
      "arguments": ["instruction", "rd", "rs1", "rs2"],
      "fields": [
        {
          "name": "funct7",
          "start_bit": 25,
          "end_bit": 31,
          "description": "Specifies exact operation with funct3. Contains opcode modifiers."
        },
        {
          "name": "rs2",
          "start_bit": 20,
          "end_bit": 24,
          "description": "Source register 2 - second operand."
        },
        {
          "name": "rs1",
          "start_bit": 15,
          "end_bit": 19,
          "description": "Source register 1 - first operand."
        },
        {
          "name": "funct3",
          "start_bit": 12,
          "end_bit": 14,
          "description": "Specifies operation variant (ADD, SUB, etc.)."
        },
        {
          "name": "rd",
          "start_bit": 7,
          "end_bit": 11,
          "description": "Destination register - stores the result."
        },
        {
          "name": "opcode",
          "start_bit": 0,
          "end_bit": 6,
          "description": "Operation code - 0x33 for R-format."
        }
      ]
    },
    "I": {
      "description": "Immediate operations. Uses rd = rs1 op imm[11:0].",
      "arguments": ["instruction", "rd", "rs1", "imm"],
      "fields": [
        {
          "name": "imm[11:0]",
          "start_bit": 20,
          "end_bit": 31,
          "description": "12-bit signed immediate value."
        },
        {
          "name": "rs1",
          "start_bit": 15,
          "end_bit": 19,
          "description": "Source register - operand."
        },
        {
          "name": "funct3",
          "start_bit": 12,
          "end_bit": 14,
          "description": "Specifies operation variant (addi, andi, etc.)."
        },
        {
          "name": "rd",
          "start_bit": 7,
          "end_bit": 11,
          "description": "Destination register - stores the result."
        },
        {
          "name": "opcode",
          "start_bit": 0,
          "end_bit": 6,
          "description": "Operation code - 0x13, 0x03, 0x67, 0x73, etc."
        }
      ]
    },
    "S": {
      "description": "Store operations. Stores rs2 at address rs1 + imm[11:0].",
      "arguments": ["instruction", "rs2", "imm", "rs1"],
      "fields": [
        {
          "name": "imm[11:5]",
          "start_bit": 25,
          "end_bit": 31,
          "description": "Upper 7 bits of 12-bit signed offset."
        },
        {
          "name": "rs2",
          "start_bit": 20,
          "end_bit": 24,
          "description": "Source register - contains value to store."
        },
        {
          "name": "rs1",
          "start_bit": 15,
          "end_bit": 19,
          "description": "Source register - base address."
        },
        {
          "name": "funct3",
          "start_bit": 12,
          "end_bit": 14,
          "description": "Specifies store size: sw=010, sh=001, sb=000."
        },
        {
          "name": "imm[4:0]",
          "start_bit": 7,
          "end_bit": 11,
          "description": "Lower 5 bits of 12-bit signed offset."
        },
        {
          "name": "opcode",
          "start_bit": 0,
          "end_bit": 6,
          "description": "Operation code - 0x23 for S-format."
        }
      ]
    },
    "B": {
      "description": "Branch operations. PC-relative branch if condition (rs1, rs2) is true.",
      "arguments": ["instruction", "rs1", "rs2", "imm"],
      "fields": [
        {
          "name": "imm[12]",
          "start_bit": 31,
          "end_bit": 31,
          "description": "Bit 12 (sign bit) of branch offset."
        },
        {
          "name": "imm[10:5]",
          "start_bit": 25,
          "end_bit": 30,
          "description": "Bits 10-5 of branch offset."
        },
        {
          "name": "rs2",
          "start_bit": 20,
          "end_bit": 24,
          "description": "Source register 2 - second operand."
        },
        {
          "name": "rs1",
          "start_bit": 15,
          "end_bit": 19,
          "description": "Source register 1 - first operand."
        },
        {
          "name": "funct3",
          "start_bit": 12,
          "end_bit": 14,
          "description": "Branch condition: beq=000, bne=001, blt=100, bge=101, etc."
        },
        {
          "name": "imm[4:1]",
          "start_bit": 8,
          "end_bit": 11,
          "description": "Bits 4-1 of branch offset (bit 0 always 0)."
        },
        {
          "name": "imm[11]",
          "start_bit": 7,
          "end_bit": 7,
          "description": "Bit 11 of branch offset."
        },
        {
          "name": "opcode",
          "start_bit": 0,
          "end_bit": 6,
          "description": "Operation code - 0x63 for B-format."
        }
      ]
    }
  }
}
